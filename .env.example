
# Set this to the exact public A2A base URL after deployment.
PUBLIC_BASE_URL=http://127.0.0.1:8000/a2a

# AI Pipe configuration. Set the real token in your deployment environment.
AIPIPE_TOKEN=replace-with-your-ai-pipe-token
OPENAI_BASE_URL=https://aipipe.org/openai/v1
AI_MODEL=gpt-5-nano

AUTONOMOUS_LIMIT_MINOR=50000
DATABASE_PATH=./data/invoice_a2a.db
